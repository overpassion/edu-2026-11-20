<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.egovframe.sample.board.mapper.BoardFileMapper">

    <resultMap id="fileResult" type="org.egovframe.sample.board.model.BoardFile">
        <id     property="fileId"   column="FILE_ID"/>
        <result property="boardId"  column="BOARD_ID"/>
        <result property="fileNm"   column="FILE_NM"/>
        <result property="filePath" column="FILE_PATH"/>
        <result property="fileSize" column="FILE_SIZE"/>
        <result property="regDt"    column="REG_DT"/>
    </resultMap>

    <!-- 게시글의 첨부파일 목록 -->
    <select id="selectFileList" resultMap="fileResult">
        SELECT FILE_ID, BOARD_ID, FILE_NM, FILE_PATH, FILE_SIZE, REG_DT
        FROM BOARD_FILE_ATT
        WHERE BOARD_ID = #{boardId}
        ORDER BY CAST(FILE_ID AS BIGINT) ASC
    </select>

    <!-- 첨부파일 단건 -->
    <select id="selectFile" resultMap="fileResult">
        SELECT FILE_ID, BOARD_ID, FILE_NM, FILE_PATH, FILE_SIZE, REG_DT
        FROM BOARD_FILE_ATT
        WHERE FILE_ID = #{fileId}
    </select>

    <!-- 첨부파일 등록 : SEQ_BOARD_FILE 로 ID 자동 발급 -->
    <insert id="insertFile" parameterType="org.egovframe.sample.board.model.BoardFile">
        <selectKey keyProperty="fileId" resultType="string" order="BEFORE">
            SELECT CAST(NEXT VALUE FOR SEQ_BOARD_FILE AS VARCHAR(20)) FROM (VALUES(0))
        </selectKey>
        INSERT INTO BOARD_FILE_ATT (FILE_ID, BOARD_ID, FILE_NM, FILE_PATH, FILE_SIZE, REG_DT)
        VALUES (#{fileId}, #{boardId}, #{fileNm}, #{filePath}, #{fileSize}, CURRENT_TIMESTAMP)
    </insert>

    <!-- 게시글 소속 전체 삭제 -->
    <delete id="deleteFileByBoard">
        DELETE FROM BOARD_FILE_ATT
        WHERE BOARD_ID = #{boardId}
    </delete>

    <!-- 단건 삭제 -->
    <delete id="deleteFile">
        DELETE FROM BOARD_FILE_ATT
        WHERE FILE_ID = #{fileId}
    </delete>

</mapper>
